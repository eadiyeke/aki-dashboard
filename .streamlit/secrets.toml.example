# Copy this file to .streamlit/secrets.toml for local testing,
# or paste its contents into Streamlit Cloud: App -> Settings -> Secrets.
# NEVER commit the real secrets.toml to GitHub.

# ---- Clinician logins: one block per clinician --------------------------
[participants.clinician01]
id = "P001"
password = "change-me-1"
display_name = "Participant 01"

[participants.clinician02]
id = "P002"
password = "change-me-2"
display_name = "Participant 02"

# ---- Google Sheet where decisions are saved ---------------------------------
# The long ID in the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
sheet_id = "PASTE_YOUR_SHEET_ID"

# ---- Google service account key -------------------------------------------
# Copy each field from the JSON key file you downloaded from Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-robot@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"

# ---- Optional: height of the dashboard area in pixels (default 680) ----------
# dashboard_height = 680
